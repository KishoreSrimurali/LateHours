# Copy this to .env (local dev with `vercel dev`) or set these as Vercel
# Project Settings → Environment Variables in production.

# Postgres connection string. Any managed Postgres works (Neon, Vercel
# Postgres, Supabase, Railway...) as long as it accepts TLS connections.
# Local Postgres during development can append ?sslmode=disable.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Anthropic API key for the AI listener (server-side only).
ANTHROPIC_API_KEY=

# Pusher app credentials (server-side) — create a free app at pusher.com,
# Channels product. IMPORTANT: turn on "Enable client events" in that
# app's dashboard settings, or in-call chat between two humans won't send.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# The same Pusher key/cluster, exposed to the browser (Vite only bundles
# env vars prefixed VITE_). The key itself is public information — the
# secret above is what actually protects anything.
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=
